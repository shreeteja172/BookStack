generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  role          String   @default("member")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions     Session[]
  accounts     Account[]
  loans        Loan[]
  reservations Reservation[]

  @@map("users")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verifications")
}

model Book {
  id            String   @id @default(cuid())
  title         String
  author        String
  isbn          String   @unique
  publisher     String?
  category      String
  description   String?
  publishedYear Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  copies       BookCopy[]
  reservations Reservation[]

  @@index([category])
  @@index([author])
  @@map("books")
}

model BookCopy {
  id      String @id @default(cuid())
  barcode String @unique
  floor   String
  shelf   String
  row     String
  status  String @default("available")

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  loans Loan[]

  @@index([bookId])
  @@index([status])
  @@map("book_copies")
}

model Loan {
  id         String    @id @default(cuid())
  issuedAt   DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?
  fineCents  Int       @default(0)

  copyId String
  copy   BookCopy @relation(fields: [copyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([copyId])
  @@index([returnedAt])
  @@map("loans")
}

model Reservation {
  id        String    @id @default(cuid())
  status    String    @default("waiting")
  createdAt DateTime  @default(now())
  readyAt   DateTime?

  bookId String
  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
  @@index([bookId, createdAt])
  @@map("reservations")
}
